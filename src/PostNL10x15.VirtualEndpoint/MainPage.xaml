<Page
    x:Class="PostNL10x15.VirtualEndpoint.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="PostNL 10x15" />
            <TextBlock
                Margin="0,16,0,0"
                FontSize="16"
                TextWrapping="Wrap"
                Text="Deze Windows-printer snijdt PostNL-labels automatisch uit en stuurt ze naar de ingestelde doelprinter." />
            <TextBlock
                Margin="0,16,0,0"
                FontSize="16"
                FontWeight="SemiBold"
                Text="De doelprinter wordt tijdens de installatie gekozen." />
            <TextBlock
                Margin="0,8,0,0"
                Foreground="DarkGreen"
                Text="De printer werkt op de achtergrond; dit venster hoeft niet open te blijven." />
        </StackPanel>
    </Grid>
</Page>
