<Page
    x:Class="PostNL10x15.VirtualEndpoint.JobPreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                x:Uid="PreviewTitle"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Is this label correct?" />
            <TextBlock
                x:Uid="PreviewExplanation"
                Margin="0,8,0,0"
                FontSize="16"
                Text="The label is printed only after you select Print." />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,20,0,20"
            Padding="12"
            Background="White"
            BorderBrush="#FFB8B8B8"
            BorderThickness="1"
            CornerRadius="6">
            <Grid>
                <Image
                    x:Name="PreviewImage"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Stretch="Uniform" />

                <StackPanel
                    x:Name="LoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ProgressRing
                        Width="42"
                        Height="42"
                        IsActive="True" />
                    <TextBlock
                        x:Uid="PreviewLoading"
                        Margin="0,12,0,0"
                        Foreground="#FF1A1A1A"
                        Text="Preparing the label..." />
                </StackPanel>

                <TextBlock
                    x:Name="PreviewError"
                    x:Uid="PreviewError"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="17"
                    Foreground="#FFC42B1C"
                    Text="The label preview could not be shown. Select Cancel and try again."
                    TextAlignment="Center"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <TextBlock
                x:Name="PrinterText"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold" />

            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="CancelButton"
                    x:Uid="PreviewCancelButton"
                    MinWidth="120"
                    Content="Cancel"
                    Click="CancelClicked" />
                <Button
                    x:Name="PrintButton"
                    x:Uid="PreviewPrintButton"
                    MinWidth="140"
                    Margin="12,0,0,0"
                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    Content="Print"
                    Foreground="White"
                    IsEnabled="False"
                    Click="PrintClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
