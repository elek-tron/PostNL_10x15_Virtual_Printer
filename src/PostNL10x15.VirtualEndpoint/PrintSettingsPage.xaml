<Page
    x:Class="PostNL10x15.VirtualEndpoint.PrintSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock
                x:Uid="SettingsTitle"
                FontSize="28"
                FontWeight="SemiBold"
                Text="PostNL 10x15" />

            <Border
                Margin="0,24,0,0"
                Padding="20"
                Background="#FFF3F8FD"
                BorderBrush="#FF0078D4"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel>
                    <TextBlock
                        x:Uid="FixedOutput"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="#FF1A1A1A"
                        Text="Fixed output size: 10 × 15 cm" />
                    <TextBlock
                        x:Uid="AutomaticOrientation"
                        Margin="0,12,0,0"
                        FontSize="16"
                        Foreground="#FF1A1A1A"
                        Text="Orientation: automatic" />
                    <TextBlock
                        x:Uid="AutomaticMargins"
                        Margin="0,6,0,0"
                        FontSize="16"
                        Foreground="#FF1A1A1A"
                        Text="White margins: removed automatically" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Uid="NoSettingsNeeded"
                Margin="0,24,0,0"
                FontSize="17"
                FontWeight="SemiBold"
                Text="No settings are needed." />
            <TextBlock
                x:Uid="AutomaticProcessing"
                Margin="0,8,0,0"
                MaxWidth="520"
                HorizontalAlignment="Left"
                FontSize="15"
                TextWrapping="Wrap"
                Text="The shipping label is cropped automatically and fitted to the label printer selected during installation." />
        </StackPanel>

        <Button
            x:Uid="OkButton"
            Grid.Row="1"
            MinWidth="112"
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Content="OK"
            Click="OkClicked" />
    </Grid>
</Page>
